# ScopeGuard Environment Configuration
# Copy to .env and adjust for your environment.

# Application
SCOPEGUARD_ENVIRONMENT=development
SCOPEGUARD_DEBUG=false
SCOPEGUARD_LOG_LEVEL=INFO

# Server
SCOPEGUARD_HOST=127.0.0.1
SCOPEGUARD_PORT=8000

# CORS (comma-separated origins)
SCOPEGUARD_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Risk gating threshold (0-100)
SCOPEGUARD_RISK_THRESHOLD=75
